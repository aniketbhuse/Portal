@model List<CRMPortal.Models.MasterEmployee>

@{
    ViewData["Title"] = "Employee Master";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fa-solid fa-circle-check me-2"></i>
        @TempData["Success"]

        <button class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        @TempData["Error"]

        <button class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<link rel="stylesheet"
      href="~/css/ApplyLeave.css"
      asp-append-version="true" />

<div class="container-fluid mt-3 top" style="margin-left: -110px;">

    <!-- Summary Card -->

    <div class="row mb-3">
        <div class="col-md-8">

            <div class="row">

                <div class="col-md-4">

                    <div class="card shadow text-center dashboard-card">

                        <div class="card-body">

                            <i class="fa-solid fa-users summary-icon text-primary"></i>

                            <h6>Total Employees</h6>

                            <h2 class="text-primary">
                                @ViewBag.TotalEmployees
                            </h2>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card shadow text-center dashboard-card">

                        <div class="card-body">

                            <i class="fa-solid fa-user-check summary-icon text-success"></i>

                            <h6>Active Employees</h6>

                            <h2 class="text-success">
                                @ViewBag.ActiveEmployees
                            </h2>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card shadow text-center dashboard-card">

                        <div class="card-body">

                            <i class="fa-solid fa-user-xmark summary-icon text-danger"></i>

                            <h6>Inactive Employees</h6>

                            <h2 class="text-danger">
                                @ViewBag.InactiveEmployees
                            </h2>

                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>


    <!-- Employee Table -->

    <div class="card shadow" style="width: 120%;">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                <i class="fa-solid fa-users me-2"></i>
                Employee Master List
            </h4>

            <a asp-action="ExportEmployeesToExcel"
               class="btn btn-success exporttoexcel">

                <i class="fa-solid fa-file-excel me-1"></i>
                Export to Excel

            </a>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered table-hover table-striped align-middle mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>Action</th>
                            <th>Status</th>
                            <th>Employee Code</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Gender</th>
                            <th>DOB</th>
                            <th>Blood Group</th>
                            <th>Marital Status</th>
                            <th>Mobile</th>
                            <th>Address</th>
                            <th>Pincode</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Joining Date</th>
                            <th>Employment Type</th>
                            <th>Reporting Manager</th>
                            <th>Shift</th>
                            <th>Salary</th>
                            <th>Aadhaar</th>
                            <th>PAN</th>
                            <th>Bank</th>
                            <th>Account No.</th>
                            <th>IFSC</th>
                            <th>Created</th>
                            <th>Updated</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td style="min-width:140px;">

                                    <a asp-action="EditEmployee"
                                       asp-route-id="@item.EmployeeId"
                                       class="btn btn-warning btn-sm">

                                        <i class="fa-solid fa-pen-to-square"></i>
                                        Edit

                                    </a>

                                    <a asp-action="DeleteEmployee"
                                       asp-route-id="@item.EmployeeId"
                                       onclick="return confirm('Delete Employee?')"
                                       class="btn btn-danger btn-sm">

                                        <i class="fa-solid fa-user-slash"></i>
                                        InActivate

                                    </a>

                                </td>


                                <td>

                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge bg-danger">

                                            <i class="fa-solid fa-circle-xmark me-1"></i>
                                            Inactive

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">

                                            <i class="fa-solid fa-circle-check me-1"></i>
                                            Active

                                        </span>
                                    }

                                </td>


                                <td>@item.EmployeeCode</td>

                                <td>@item.FullName</td>


                                <td>

                                    <a href="mailto:@item.Email"
                                       class="text-decoration-none text-primary fw-semibold"
                                       title="Send Email to @item.FullName">

                                        <i class="fa-solid fa-envelope me-1"></i>
                                        @item.Email

                                    </a>

                                </td>


                                <td>@item.Gender</td>

                                <td>@item.DateOfBirth</td>

                                <td>@item.BloodGroup</td>

                                <td>@item.MaritalStatus</td>

                                <td>@item.MobileNumber</td>

                                <td>@item.AddressLine1</td>

                                <td>@item.Pincode</td>

                                <td>@item.Department</td>

                                <td>@item.Designation</td>

                                <td>@item.JoiningDate</td>

                                <td>@item.EmploymentType</td>

                                <td>@item.ReportingManager</td>

                                <td>@item.Shift</td>

                                <td>₹ @item.Salary.ToString("N2")</td>

                                <td>@item.AadhaarNumber</td>

                                <td>@item.PANNumber</td>

                                <td>@item.BankName</td>

                                <td>@item.AccountNumber</td>

                                <td>@item.IFSCCode</td>

                                <td>@item.CreatedDate.ToString("dd-MM-yyyy")</td>

                                <td>@item.UpdatedDate.ToString("dd-MM-yyyy")</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<style>

    .card {
        border-radius: 12px;
    }

    .summary-icon {
        font-size: 25px;
        margin-bottom: 8px;
    }

    /* TABLE SCROLL AREA */
    .table-responsive {
        overflow-x: auto;
        overflow-y: auto;
        max-height: 75vh;
        position: relative;
    }

    /* FIX TABLE HEADER VISIBILITY */
    .table thead {
        position: sticky;
        top: 0;
        z-index: 20;
    }

        .table thead th {
            position: sticky;
            top: 0;
            z-index: 21;
            background-color: #212529 !important;
            color: #ffffff !important;
            white-space: nowrap;
            vertical-align: middle;
            border-color: #454d55 !important;
        }

    .table td,
    .table th {
        white-space: nowrap;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #eef7ff;
        transition: .2s;
    }

    .badge {
        font-size: 14px;
    }

    .top {
        margin-top: 70px;
    }

    .exporttoexcel {
        margin-left: 89%;
        margin-top: -35px;
    }

</style>