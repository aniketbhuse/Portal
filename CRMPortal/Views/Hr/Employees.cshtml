@model List<CRMPortal.Models.MasterEmployee>

@{
    ViewData["Title"] = "Employee Master";
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<!-- Page styles -->
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<script src="~/js/site.js"></script>

<div class="container-fluid em-page">

    <!-- ===================================================== -->
    <!-- SUCCESS / ERROR MESSAGES -->
    <!-- ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show em-top">
            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show em-top">
            <i class="fa-solid fa-circle-exclamation me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- ===================================================== -->
    <!-- SUMMARY CARDS -->
    <!-- ===================================================== -->
    <div class="row g-3 mb-4 ">

        <!-- TOTAL EMPLOYEES -->
        <div class="col-12 col-md-4">
            <div class="dashboard-card em-stat em-stat--primary">
                <div class="summary-icon-wrapper text-primary">
                    <i class="fa-solid fa-users"></i>
                </div>

                <div class="em-stat__body">
                    <h6>Total Employees</h6>
                    <h2 class="text-primary">@ViewBag.TotalEmployees</h2>
                </div>

            </div>
        </div>

        <!-- ACTIVE EMPLOYEES -->
        <div class="col-12 col-md-4">
            <div class="dashboard-card em-stat em-stat--success">
                <div class="summary-icon-wrapper text-success">
                    <i class="fa-solid fa-user-check"></i>
                </div>

                <div class="em-stat__body">
                    <h6>Active Employees</h6>
                    <h2 class="text-success">@ViewBag.ActiveEmployees</h2>
                </div>

            </div>
        </div>

        <!-- INACTIVE EMPLOYEES -->
        <div class="col-12 col-md-4">
            <div class="dashboard-card em-stat em-stat--danger">

                <div class="summary-icon-wrapper text-danger">
                    <i class="fa-solid fa-user-xmark"></i>
                </div>

                <div class="em-stat__body">
                    <h6>Inactive Employees</h6>
                    <h2 class="text-danger">@ViewBag.InactiveEmployees</h2>
                </div>

            </div>
        </div>

    </div>


    <!-- ===================================================== -->
    <!-- EMPLOYEE MASTER TABLE -->
    <!-- ===================================================== -->
    <div class="em-card">

        <!-- TABLE HEADER -->
        <div class="em-card__head">

            <h4 class="em-card__title">
                <i class="fa-solid fa-users me-2"></i>
                Employee Master List
            </h4>

            <!-- EXPORT BUTTON -->
            <a asp-action="ExportEmployeesToExcel"
               class="btn btn-success exporttoexcel">
                <i class="fa-solid fa-file-excel me-1"></i>
                Export to Excel
            </a>

        </div>


        <!-- TABLE BODY -->
        <div class="em-card__body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 em-table">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Status</th>
                            <th>Employee Code</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Mobile Number</th>
                            <th>Emergency Contact Name</th>
                            <th>Emergency Contact</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Gender</th>
                            <th>Date Of Birth</th>
                            <th>Joining Date</th>
                            <th>Salary</th>
                            <th>Blood Group</th>
                            <th>Marital Status</th>
                            <th>Address</th>
                            <th>Pincode</th>
                            <th>Employment Type</th>
                            <th>Reporting Manager</th>
                            <th>Shift</th>
                            <th>Aadhaar Number</th>
                            <th>PAN Number</th>
                            <th>Bank Name</th>
                            <th>Account Number</th>
                            <th>IFSC Code</th>
                            <th>Created</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="em-col-action">

                                    <a asp-action="EditEmployee"
                                       asp-route-id="@item.EmployeeId"
                                       class="btn btn-warning btn-sm">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        Edit
                                    </a>

                                    @if (item.IsDeleted)
                                    {
                                        <form asp-action="ActivateEmployee"
                                              asp-route-id="@item.EmployeeId"
                                              method="post" style="display: inline;">

                                            <button type="submit"
                                                    class="btn btn-success btn-sm"
                                                    onclick="return confirm('Are you sure you want to activate this employee?');">

                                                <i class="fa-solid fa-user-check"></i>
                                                Activate
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="DeleteEmployee"
                                              asp-route-id="@item.EmployeeId"
                                              method="post" style="display: inline;">

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to inactivate this employee?');">

                                                <i class="fa-solid fa-user-slash"></i>
                                                InActivate
                                            </button>
                                        </form>
                                    }

                                </td>

                                <td>

                                    @if (item.IsDeleted)
                                    {
                                        <!-- INACTIVE -->
                                        <span class="badge bg-danger">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>
                                            Inactive
                                        </span>
                                    }
                                    else
                                    {
                                        <!-- ACTIVE -->
                                        <span class="badge bg-success">
                                            <i class="fa-solid fa-circle-check me-1"></i>
                                            Active
                                        </span>
                                    }

                                </td>

                                <td>@item.EmployeeCode</td>

                                <td>
                                    <a href="javascript:void(0);"
                                       class="employee-details-link"
                                       data-id="@item.EmployeeId">
                                        @item.FullName
                                    </a>
                                </td>

                                <td>
                                    <a href="mailto:@item.Email"
                                       class="text-decoration-none text-primary fw-semibold"
                                       title="Send Email to @item.FullName">
                                        <i class="fa-solid fa-envelope me-1"></i>
                                        @item.Email
                                    </a>
                                </td>

                                <td>@item.MobileNumber</td>
                                <td>@item.EmergencyContactName</td>
                                <td>@item.EmergencyContact</td>
                                <td>@item.Department</td>
                                <td>@item.Designation</td>
                                <td>@item.Gender</td>
                                <td>@item.DateOfBirth</td>
                                <td>@item.JoiningDate</td>
                                <td>₹ @item.Salary.ToString("N2")</td>
                                <td>@item.BloodGroup</td>
                                <td>@item.MaritalStatus</td>
                                <td>@item.AddressLine1</td>
                                <td>@item.Pincode</td>
                                <td>@item.EmploymentType</td>
                                <td>@item.ReportingManager</td>
                                <td>@item.Shift</td>
                                <td>@item.AadhaarNumber</td>
                                <td>@item.PANNumber</td>
                                <td>@item.BankName</td>
                                <td>@item.AccountNumber</td>
                                <td>@item.IFSCCode</td>
                                <td>@item.CreatedDate.ToString("dd-MM-yyyy")</td>
                                <td>@item.UpdatedDate.ToString("dd-MM-yyyy")</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- EMPLOYEE DETAILS MODAL (partial view loads inside) -->

<div class="modal fade" id="employeeDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Employee Details
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body" id="employeeDetailsContainer">

                <!-- Partial View loads here -->

            </div>

        </div>

    </div>

</div>


