@model CRMPortal.ViewModels.AttendanceReportViewModel

@{
    // ============================================================
    // ATTENDANCE STATUS COUNTS
    // ============================================================

    var paidLeaveCount = Model.AttendanceList?
        .Count(x => x.Status == "PL") ?? 0;

    var halfDayCount = Model.AttendanceList?
        .Count(x => x.Status == "HD") ?? 0;

    var ncnsCount = Model.AttendanceList?
        .Count(x => x.Status == "NCNS") ?? 0;

    var lwpCount = Model.AttendanceList?
        .Count(x => x.Status == "LWP") ?? 0;

    var ulwpCount = Model.AttendanceList?
        .Count(x => x.Status == "ULWP") ?? 0;

    var slCount = Model.AttendanceList?
        .Count(x => x.Status == "SL") ?? 0;

    var companyHolidayCount = Model.AttendanceList?
        .Count(x => x.Status == "CH") ?? 0;
}

<style>
    .container-fluid {
        max-width: 1400px;
        margin: auto;
    }

    .card {
        border-radius: 8px;
        margin-bottom: 12px;
    }

    .card-header {
        padding: 8px 15px;
    }

        .card-header h4,
        .card-header h5 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .card-body {
        padding: 15px;
    }

    .form-control,
    .form-select {
        height: 34px;
        font-size: 13px;
        padding: 4px 10px;
    }

    textarea.form-control {
        height: 70px;
    }

    label {
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .mb-3 {
        margin-bottom: 10px !important;
    }

    .btn {
        height: 36px;
        font-size: 14px;
        padding: 5px 15px;
    }

        .btn i {
            font-size: 14px;
        }

    #employeeName {
        height: 34px;
    }

    .row {
        --bs-gutter-y: 0.7rem;
    }

    .table td,
    .table th {
        color: #000 !important;
    }

    /* ============================================================
           STAT CARDS  -  5 EQUAL CARDS PER LINE, SAME SIZE EVERYWHERE
           ============================================================ */

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 16px;
        margin-top: 20px;
        margin-bottom: 20px;
    }

        .stat-grid .card.summary-card {
            height: 110px;
            margin: 0;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .stat-grid .card.summary-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 6px 15px rgba(0,0,0,0.15) !important;
            }

        .stat-grid .card-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 8px 6px;
            text-align: center;
        }

        .stat-grid .stat-title {
            font-size: 13px;
            font-weight: 600;
            margin: 0 0 6px 0;
            white-space: nowrap;
        }

        .stat-grid .stat-value {
            font-size: 24px;
            font-weight: bold;
            margin: 0;
            white-space: nowrap;
        }

    /* ============================================================
           RESPONSIVE
           ============================================================ */

    @@media (max-width: 1199px) {
        .stat-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767px) {
        .stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>


<!-- ============================================================
     ERROR MESSAGE
     ============================================================ -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}


<!-- ============================================================
     FONT AWESOME
     ============================================================ -->

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<script src="~/js/site.js"></script>
<script src="~/css/site.css"></script>


<!-- ============================================================
     ATTENDANCE REPORT FILTER
     ============================================================ -->

<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <h4>
            <i class="fa-solid fa-chart-line me-2"></i>
            Attendance Report
        </h4>

    </div>


    <div class="card-body">

        <!-- VIEW REPORT -->

        <form asp-action="ViewAttendance"
              method="post">

            <div class="row">

                <!-- EMPLOYEE -->

                <div class="col-md-4">

                    <label>
                        <i class="fa-solid fa-user me-1"></i>
                        Employee
                    </label>

                    <select asp-for="EmployeeId"
                            class="form-control searchable-dropdown">

                        <option value="">
                            Select Employee
                        </option>

                        <option value="0">
                            All Employees
                        </option>

                        @foreach (var emp in Model.EmployeeList)
                        {
                            <option value="@emp.EmployeeId">
                                @emp.EmployeeCode - @emp.FullName
                            </option>
                        }

                    </select>

                </div>


                <!-- FROM DATE -->

                <div class="col-md-3">

                    <label>
                        <i class="fa-regular fa-calendar me-1"></i>
                        From Date
                    </label>

                    <input asp-for="FromDate"
                           type="date"
                           class="form-control" />

                </div>


                <!-- TO DATE -->

                <div class="col-md-3">

                    <label>
                        <i class="fa-regular fa-calendar-check me-1"></i>
                        To Date
                    </label>

                    <input asp-for="ToDate"
                           type="date"
                           class="form-control" />

                </div>


                <!-- VIEW BUTTON -->

                <div class="col-md-2 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="fa-solid fa-chart-simple me-1"></i>
                        View

                    </button>

                </div>

            </div>

        </form>


        <!-- EXPORT -->

        <form asp-action="ExportAttendanceExcel"
              asp-controller="HR"
              method="post"
              class="mt-2">

            <input type="hidden"
                   asp-for="EmployeeId" />

            <input type="hidden"
                   asp-for="FromDate" />

            <input type="hidden"
                   asp-for="ToDate" />

            <div class="row">

                <div class="col-md-2 offset-md-10">

                    <button type="submit"
                            class="btn btn-success w-100">

                        <i class="fa-solid fa-file-arrow-down me-1"></i>
                        Export

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


<!-- ============================================================
     ALL SUMMARY CARDS  (5 PER LINE, EQUAL SIZE)
     Line 1 : Total Days, Present Days, Attendance %, Paid Leave, Half Day
     Line 2 : NCNS, LWP, ULWP, SL, Company Holiday
     Line 3 : Monthly Salary, Per Day Salary, Salary Deduction, Net Salary
     ============================================================ -->

<div class="stat-grid">

    <!-- TOTAL DAYS -->
    <div class="card shadow border-primary summary-card">
        <div class="card-body">
            <h6 class="stat-title">Total Days</h6>
            <h2 class="stat-value text-primary">@Model.TotalDays</h2>
        </div>
    </div>

    <!-- PRESENT DAYS -->
    <div class="card shadow border-success summary-card">
        <div class="card-body">
            <h6 class="stat-title">Present Days</h6>
            <h2 class="stat-value text-success">@Model.PresentDays</h2>
        </div>
    </div>

    <!-- ATTENDANCE PERCENTAGE -->
    <div class="card shadow border-warning summary-card">
        <div class="card-body">
            <h6 class="stat-title">Attendance %</h6>
            <h2 class="stat-value text-warning">@Model.AttendancePercentage%</h2>
        </div>
    </div>

    <!-- PAID LEAVE -->
    <div class="card shadow border-primary summary-card">
        <div class="card-body">
            <h6 class="stat-title">
                <i class="fa-solid fa-umbrella-beach me-1"></i>
                Paid Leave
            </h6>
            <h2 class="stat-value text-primary">@paidLeaveCount</h2>
        </div>
    </div>

    <!-- HALF DAY -->
    <div class="card shadow border-warning summary-card">
        <div class="card-body">
            <h6 class="stat-title">
                <i class="fa-solid fa-clock me-1"></i>
                Half Day
            </h6>
            <h2 class="stat-value text-warning">@halfDayCount</h2>
        </div>
    </div>

    <!-- NCNS -->
    <div class="card shadow border-danger summary-card">
        <div class="card-body">
            <h6 class="stat-title">
                <i class="fa-solid fa-user-xmark me-1"></i>
                NCNS
            </h6>
            <h2 class="stat-value text-danger">@ncnsCount</h2>
        </div>
    </div>

    <!-- LWP -->
    <div class="card shadow border-danger summary-card">
        <div class="card-body">
            <h6 class="stat-title">
                <i class="fa-solid fa-user-slash me-1"></i>
                LWP
            </h6>
            <h2 class="stat-value text-danger">@lwpCount</h2>
        </div>
    </div>

    <!-- ULWP -->
    <div class="card shadow border-dark summary-card">
        <div class="card-body">
            <h6 class="stat-title">
                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                ULWP
            </h6>
            <h2 class="stat-value text-dark">@ulwpCount</h2>
        </div>
    </div>

    <!-- SL -->
    <div class="card shadow border-info summary-card">
        <div class="card-body">
            <h6 class="stat-title">
                <i class="fa-solid fa-calendar-days me-1"></i>
                SL
            </h6>
            <h2 class="stat-value text-info">@slCount</h2>
        </div>
    </div>

    <!-- COMPANY HOLIDAY -->
    <div class="card shadow border-success summary-card">
        <div class="card-body">
            <h6 class="stat-title">
                <i class="fa-solid fa-building me-1"></i>
                Company Holiday
            </h6>
            <h2 class="stat-value text-success">@companyHolidayCount</h2>
        </div>
    </div>

    <!-- MONTHLY SALARY -->
    <div class="card shadow border-primary summary-card">
        <div class="card-body position-relative">

            <h6 class="stat-title">Monthly Salary</h6>

            <h2 class="stat-value text-primary">
                <span class="salary-value"
                      data-value="₹ @Model.MonthlySalary.ToString("N2")">
                    ₹ ••••••
                </span>

                <button type="button"
                        class="btn btn-sm salary-eye-btn"
                        onclick="toggleSalary(this)"
                        title="Show Salary">
                    <i class="bi bi-eye"></i>
                </button>
            </h2>

        </div>
    </div>


    <!-- PER DAY SALARY -->
    <div class="card shadow border-info summary-card">
        <div class="card-body position-relative">

            <h6 class="stat-title">Per Day Salary</h6>

            <h2 class="stat-value text-info">
                <span class="salary-value"
                      data-value="₹ @Model.PerDaySalary.ToString("N2")">
                    ₹ ••••••
                </span>

                <button type="button"
                        class="btn btn-sm salary-eye-btn"
                        onclick="toggleSalary(this)"
                        title="Show Salary">
                    <i class="bi bi-eye"></i>
                </button>
            </h2>

        </div>
    </div>


    <!-- SALARY DEDUCTION -->
    <div class="card shadow border-danger summary-card">
        <div class="card-body position-relative">

            <h6 class="stat-title">Salary Deduction</h6>

            <h2 class="stat-value text-danger">
                <span class="salary-value"
                      data-value="₹ @Model.SalaryDeduction.ToString("N2")">
                    ₹ ••••••
                </span>

                <button type="button"
                        class="btn btn-sm salary-eye-btn"
                        onclick="toggleSalary(this)"
                        title="Show Salary">
                    <i class="bi bi-eye"></i>
                </button>
            </h2>

        </div>
    </div>


    <!-- NET SALARY -->
    <div class="card shadow border-success summary-card">
        <div class="card-body position-relative">

            <h6 class="stat-title">Net Salary</h6>

            <h2 class="stat-value text-success">
                <span class="salary-value"
                      data-value="₹ @Model.NetSalary.ToString("N2")">
                    ₹ ••••••
                </span>

                <button type="button"
                        class="btn btn-sm salary-eye-btn"
                        onclick="toggleSalary(this)"
                        title="Show Salary">
                    <i class="bi bi-eye"></i>
                </button>
            </h2>

        </div>
    </div>

</div>


<!-- ============================================================
     ATTENDANCE HISTORY
     ============================================================ -->

<div class="card mt-4 shadow">

    <div class="card-header bg-success text-white">

        <i class="fa-solid fa-clock-rotate-left me-2"></i>
        Attendance History

    </div>


    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle text-center">

                <thead class="table-light">

                    <tr>

                        <th width="18%">
                            <i class="fa-regular fa-calendar me-1"></i>
                            Date
                        </th>

                        <th width="20%">
                            <i class="fa-solid fa-circle-check me-1"></i>
                            Status
                        </th>

                        <th width="42%">
                            <i class="fa-regular fa-comment-dots me-1"></i>
                            Remarks
                        </th>

                        <th width="20%">
                            <i class="fa-solid fa-pen-to-square me-1"></i>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.AttendanceList != null &&
                         Model.AttendanceList.Any())
                    {
                        foreach (var item in Model.AttendanceList)
                        {
                            <tr>

                                <!-- DATE -->

                                <td class="fw-semibold">

                                    @item.AttendanceDate.ToString("dd-MMM-yyyy")

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @switch (item.Status)
                                    {
                                        case "Present":

                                            <span class="badge bg-success px-3 py-2">

                                                <i class="fa-solid fa-check me-1"></i>
                                                Present

                                            </span>

                                            break;


                                        case "PL":

                                            <span class="badge bg-primary px-3 py-2">

                                                <i class="fa-solid fa-umbrella-beach me-1"></i>
                                                Paid Leave

                                            </span>

                                            break;


                                        case "HD":

                                            <span class="badge bg-warning text-dark px-3 py-2">

                                                <i class="fa-solid fa-clock me-1"></i>
                                                Half Day

                                            </span>

                                            break;


                                        case "NCNS":

                                            <span class="badge bg-danger px-3 py-2">

                                                <i class="fa-solid fa-user-xmark me-1"></i>
                                                NCNS

                                            </span>

                                            break;


                                        case "LWP":

                                            <span class="badge bg-danger px-3 py-2">

                                                <i class="fa-solid fa-user-slash me-1"></i>
                                                LWP

                                            </span>

                                            break;


                                        case "ULWP":

                                            <span class="badge bg-dark px-3 py-2">

                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                                ULWP

                                            </span>

                                            break;


                                        case "SL":

                                            <span class="badge bg-info text-dark px-3 py-2">

                                                <i class="fa-solid fa-calendar-days me-1"></i>
                                                SL

                                            </span>

                                            break;


                                        case "CH":

                                            <span class="badge bg-success px-3 py-2">

                                                <i class="fa-solid fa-building me-1"></i>
                                                Company Holiday

                                            </span>

                                            break;


                                        case "Sandwich":

                                            <span class="badge bg-info text-dark px-3 py-2">

                                                <i class="fa-solid fa-layer-group me-1"></i>
                                                Sandwich

                                            </span>

                                            break;


                                        case "Abscond":

                                            <span class="badge bg-danger px-3 py-2">

                                                <i class="fa-solid fa-person-running me-1"></i>
                                                Abscond

                                            </span>

                                            break;


                                        case "Terminated":

                                            <span class="badge bg-secondary px-3 py-2">

                                                <i class="fa-solid fa-user-xmark me-1"></i>
                                                Terminated

                                            </span>

                                            break;


                                        default:

                                            <span class="badge bg-danger px-3 py-2">

                                                <i class="fa-solid fa-xmark me-1"></i>
                                                Absent

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- REMARKS -->

                                <td class="text-start">

                                    @(string.IsNullOrWhiteSpace(item.Remarks)
                                        ? "-"
                                        : item.Remarks)

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <div class="d-flex justify-content-center gap-2">

                                        <!-- EDIT -->

                                        <a asp-controller="HR"
                                           asp-action="EditAttendance"
                                           asp-route-attendanceId="@item.AttendanceId"
                                           class="btn btn-outline-primary btn-sm rounded-pill px-3">

                                            <i class="fa-solid fa-pen-to-square me-1"></i>
                                            Edit

                                        </a>


                                        <!-- DELETE -->

                                        <form asp-controller="HR"
                                              asp-action="DeleteAttendance"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this attendance entry?');">

                                            <input type="hidden"
                                                   name="attendanceId"
                                                   value="@item.AttendanceId" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm rounded-pill px-3">

                                                <i class="fa-solid fa-trash me-1"></i>
                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4"
                                class="text-center py-4">

                                <i class="fa-regular fa-folder-open fa-2x text-secondary mb-2"></i>

                                <div class="text-muted fw-semibold">
                                    No Attendance Found
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
