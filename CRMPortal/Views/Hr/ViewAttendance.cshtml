@model CRMPortal.ViewModels.AttendanceReportViewModel

<style>
    /* Main Container */
    .container-fluid {
        max-width: 1400px;
        margin: auto;
    }

    /* Card */
    .card {
        border-radius: 8px;
        margin-bottom: 12px;
    }

    .card-header {
        padding: 8px 15px;
    }

        .card-header h4,
        .card-header h5 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .card-body {
        padding: 15px;
    }

    /* Dashboard Summary Cards */
    .card h6 {
        font-size: 13px;
        margin-bottom: 5px;
    }

    .card h2 {
        font-size: 24px;
        margin: 0;
        font-weight: bold;
    }

    /* Form Controls */
    .form-control,
    .form-select {
        height: 34px;
        font-size: 13px;
        padding: 4px 10px;
    }

    textarea.form-control {
        height: 70px;
    }

    /* Labels */
    label {
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 3px;
    }

    /* Reduce spacing between fields */
    .mb-3 {
        margin-bottom: 10px !important;
    }

    /* Buttons */
    .btn {
        height: 36px;
        font-size: 14px;
        padding: 5px 15px;
    }

        /* Modern Button Icons */
        .btn i {
            font-size: 14px;
        }

    /* Attendance Card */
    #employeeName {
        height: 34px;
    }

    /* Reduce row spacing */
    .row {
        --bs-gutter-y: 0.7rem;
    }

    .cardview {
        width: 80%;
        margin-left: 70px;
    }

    /* Summary Card Hover */
    .summary-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .summary-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.15) !important;
        }

    /* Table Text */
    .table td,
    .table th {
        color: #000 !important;
    }
</style>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<link rel="stylesheet"
      href="~/css/ApplyLeave.css"
      asp-append-version="true" />

<!-- ATTENDANCE REPORT FILTER -->
<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <h4>
            <i class="fa-solid fa-chart-line me-2"></i>
            Attendance Report
        </h4>

    </div>

    <div class="card-body">

        <!-- VIEW FORM -->
        <form asp-action="ViewAttendance" method="post">

            <div class="row">

                <div class="col-md-4">

                    <label>
                        <i class="fa-solid fa-user me-1"></i>
                        Employee
                    </label>

                    <select asp-for="EmployeeId"
                            class="form-control">

                        <option value="">
                            Select Employee
                        </option>

                        <option value="0">
                            All Employees
                        </option>

                        @foreach (var emp in Model.EmployeeList)
                        {
                            <option value="@emp.EmployeeId">

                                @emp.EmployeeCode -
                                @emp.FullName

                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label>
                        <i class="fa-regular fa-calendar me-1"></i>
                        From Date
                    </label>

                    <input asp-for="FromDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label>
                        <i class="fa-regular fa-calendar-check me-1"></i>
                        To Date
                    </label>

                    <input asp-for="ToDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-2 d-flex align-items-end">

                    <button class="btn btn-primary w-100"
                            type="submit">

                        <i class="fa-solid fa-chart-simple me-1"></i>

                        View

                    </button>

                </div>

            </div>

        </form>

        <!-- EXPORT BUTTON -->
        <form asp-action="ExportAttendanceExcel"
              asp-controller="HR"
              method="post"
              class="mt-2">

            <input type="hidden"
                   asp-for="EmployeeId" />

            <input type="hidden"
                   asp-for="FromDate" />

            <input type="hidden"
                   asp-for="ToDate" />

            <div class="row">

                <div class="col-md-2 offset-md-10">

                    <button type="submit"
                            class="btn btn-success w-100">

                        <i class="fa-solid fa-file-arrow-down me-1"></i>

                        Export

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<!-- SUMMARY CARDS -->
<div class="row mt-4 cardview">

    <div class="col-md-3">

        <div class="card shadow text-center border-primary summary-card">

            <div class="card-body">

                <h6>Total Days</h6>

                <h2 class="text-primary">

                    @Model.TotalDays

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow text-center border-success summary-card">

            <div class="card-body">

                <h6>Present Days</h6>

                <h2 class="text-success">

                    @Model.PresentDays

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow text-center border-danger summary-card">

            <div class="card-body">

                <h6>Absent Days</h6>

                <h2 class="text-danger">

                    @Model.AbsentDays

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow text-center border-warning summary-card">

            <div class="card-body">

                <h6>Attendance %</h6>

                <h2 class="text-warning">

                    @Model.AttendancePercentage%

                </h2>

            </div>

        </div>

    </div>

</div>

<!-- SALARY CARDS -->
<div class="row mt-4 cardview">

    <div class="col-md-3">

        <div class="card shadow border-start border-primary summary-card">

            <div class="card-body text-center">

                <h6>Monthly Salary</h6>

                <h3 class="text-primary">

                    ₹ @Model.MonthlySalary.ToString("N2")

                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow border-start border-info summary-card">

            <div class="card-body text-center">

                <h6>Per Day Salary</h6>

                <h3 class="text-info">

                    ₹ @Model.PerDaySalary.ToString("N2")

                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow border-start border-danger summary-card">

            <div class="card-body text-center">

                <h6>Salary Deduction</h6>

                <h3 class="text-danger">

                    ₹ @Model.SalaryDeduction.ToString("N2")

                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow border-start border-success summary-card">

            <div class="card-body text-center">

                <h6>Net Salary</h6>

                <h3 class="text-success">

                    ₹ @Model.NetSalary.ToString("N2")

                </h3>

            </div>

        </div>

    </div>

</div>

<!-- WORKING DAYS CARDS -->
<div class="row mt-4 cardview">

    <div class="col-md-3">

        <div class="card text-center shadow summary-card">

            <div class="card-body">

                <h6>Total Days</h6>

                <h3>@Model.TotalDays</h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center shadow summary-card">

            <div class="card-body">

                <h6>Saturday</h6>

                <h3>@Model.SaturdayCount</h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center shadow summary-card">

            <div class="card-body">

                <h6>Sunday</h6>

                <h3>@Model.SundayCount</h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center shadow summary-card">

            <div class="card-body">

                <h6>Working Days</h6>

                <h3>@Model.WorkingDays</h3>

            </div>

        </div>

    </div>

</div>

<!-- ATTENDANCE HISTORY -->
<!-- ATTENDANCE HISTORY -->
<div class="card mt-4 shadow">

    <div class="card-header bg-success text-white">

        <i class="fa-solid fa-clock-rotate-left me-2"></i>
        Attendance History

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle text-center">

                <thead class="table-light">

                    <tr>

                        <th width="18%">
                            <i class="fa-regular fa-calendar me-1"></i>
                            Date
                        </th>

                        <th width="20%">
                            <i class="fa-solid fa-circle-check me-1"></i>
                            Status
                        </th>

                        <th width="42%">
                            <i class="fa-regular fa-comment-dots me-1"></i>
                            Remarks
                        </th>

                        <th width="20%">
                            <i class="fa-solid fa-pen-to-square me-1"></i>
                            Action
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.AttendanceList.Any())
                    {
                        foreach (var item in Model.AttendanceList)
                        {
                            <tr>

                                <!-- Date -->
                                <td class="fw-semibold">
                                    @item.AttendanceDate.ToString("dd-MMM-yyyy")
                                </td>

                                <!-- Status Badge -->
                                <td>

                                    @switch (item.Status)
                                    {
                                        case "Present":
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="fa-solid fa-check me-1"></i> Present
                                            </span>
                                            break;

                                        case "PL":
                                            <span class="badge bg-primary px-3 py-2">
                                                <i class="fa-solid fa-umbrella-beach me-1"></i> Paid Leave
                                            </span>
                                            break;

                                        case "HD":
                                            <span class="badge bg-warning text-dark px-3 py-2">
                                                <i class="fa-solid fa-clock me-1"></i> Half Day
                                            </span>
                                            break;

                                        case "LWP":
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="fa-solid fa-user-slash me-1"></i> LWP
                                            </span>
                                            break;

                                        case "ULWP":
                                            <span class="badge bg-dark px-3 py-2">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i> ULWP
                                            </span>
                                            break;

                                        case "Sandwich":
                                            <span class="badge bg-info text-dark px-3 py-2">
                                                <i class="fa-solid fa-layer-group me-1"></i> Sandwich
                                            </span>
                                            break;

                                        case "Abscond":
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="fa-solid fa-person-running me-1"></i> Abscond
                                            </span>
                                            break;

                                        case "Terminated":
                                            <span class="badge bg-secondary px-3 py-2">
                                                <i class="fa-solid fa-user-xmark me-1"></i> Terminated
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="fa-solid fa-xmark me-1"></i> Absent
                                            </span>
                                            break;
                                    }

                                </td>

                                <!-- Remarks -->
                                <td class="text-start">
                                    @(string.IsNullOrWhiteSpace(item.Remarks)
                                        ? "-"
                                        : item.Remarks)
                                </td>

                                <!-- Edit Button -->
                                <td>

                                    <a asp-controller="HR"
                                       asp-action="EditAttendance"
                                       asp-route-attendanceId="@item.AttendanceId"
                                       class="btn btn-outline-primary btn-sm rounded-pill px-3">

                                        <i class="fa-solid fa-pen-to-square me-1"></i>
                                        Edit

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4" class="text-center py-4">

                                <i class="fa-regular fa-folder-open fa-2x text-secondary mb-2"></i>

                                <div class="text-muted fw-semibold">
                                    No Attendance Found
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>