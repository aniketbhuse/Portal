@model CRMPortal.ViewModels.AttendanceReportViewModel

<style>
    /* Main Container */
    .container-fluid {
        max-width: 1400px;
        margin: auto;
    }

    /* Card */
    .card {
        border-radius: 8px;
        margin-bottom: 12px;
    }

    .card-header {
        padding: 8px 15px;
    }

        .card-header h4,
        .card-header h5 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .card-body {
        padding: 15px;
    }

    /* Dashboard Summary Cards */
    .card h6 {
        font-size: 13px;
        margin-bottom: 5px;
    }

    .card h2 {
        font-size: 24px;
        margin: 0;
        font-weight: bold;
    }

    /* Form Controls */
    .form-control,
    .form-select {
        height: 34px;
        font-size: 13px;
        padding: 4px 10px;
    }

    textarea.form-control {
        height: 70px;
    }

    /* Labels */
    label {
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 3px;
    }

    /* Reduce spacing between fields */
    .mb-3 {
        margin-bottom: 10px !important;
    }

    /* Buttons */
    .btn {
        height: 36px;
        font-size: 14px;
        padding: 5px 15px;
    }

    /* Attendance Card */
    #employeeName {
        height: 34px;
    }

    /* Reduce row spacing */
    .row {
        --bs-gutter-y: 0.7rem;
    }

    .cardview{
        width: 80%;
        margin-left: 70px;
    }

    .attendances{
        width: 200px;
        margin-left: 80%;
        margin-top: -29px;
    }
   
</style>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <h4>Attendance Report</h4>

    </div>

    <div class="card-body">

        <form asp-action="ViewAttendance" method="post">

            <div class="row">

                <div class="col-md-4">

                    <label>Employee</label>

                    <select asp-for="EmployeeId" class="form-control">

                        <option value="">Select Employee</option>

                        <option value="0"> All Employees</option>

                        @foreach (var emp in Model.EmployeeList)
                        {
                            <option value="@emp.EmployeeId">

                                @emp.EmployeeCode -
                                @emp.FullName

                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label>From Date</label>

                    <input asp-for="FromDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label>To Date</label>

                    <input asp-for="ToDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-2 d-flex align-items-end">

                    <button class="btn btn-primary w-100">

                        View

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<div class="row mt-4 cardview">

    <div class="col-md-3">

        <div class="card shadow text-center border-primary">

            <div class="card-body">

                <h6>Total Days</h6>

                <h2 class="text-primary">

                    @Model.TotalDays

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow text-center border-success">

            <div class="card-body">

                <h6>Present Days</h6>

                <h2 class="text-success">

                    @Model.PresentDays

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow text-center border-danger">

            <div class="card-body">

                <h6>Absent Days</h6>

                <h2 class="text-danger">

                    @Model.AbsentDays

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow text-center border-warning">

            <div class="card-body">

                <h6>Attendance %</h6>

                <h2 class="text-warning">

                    @Model.AttendancePercentage%

                </h2>

            </div>

        </div>

    </div>

</div>

<div class="row mt-4 cardview">

    <div class="col-md-3">

        <div class="card shadow border-start border-primary">

            <div class="card-body text-center">

                <h6>Monthly Salary</h6>

                <h3 class="text-primary">

                    ₹ @Model.MonthlySalary.ToString("N2")

                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow border-start border-info">

            <div class="card-body text-center">

                <h6>Per Day Salary</h6>

                <h3 class="text-info">

                    ₹ @Model.PerDaySalary.ToString("N2")

                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow border-start border-danger">

            <div class="card-body text-center">

                <h6>Salary Deduction</h6>

                <h3 class="text-danger">

                    ₹ @Model.SalaryDeduction.ToString("N2")

                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow border-start border-success">

            <div class="card-body text-center">

                <h6>Net Salary</h6>

                <h3 class="text-success">

                    ₹ @Model.NetSalary.ToString("N2")

                </h3>

            </div>

        </div>

    </div>

</div>

<div class="row mt-4 cardview">

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h6>Total Days</h6>
                <h3>@Model.TotalDays</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h6>Saturday</h6>
                <h3>@Model.SaturdayCount</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h6>Sunday</h6>
                <h3>@Model.SundayCount</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h6>Working Days</h6>
                <h3>@Model.WorkingDays</h3>
            </div>
        </div>
    </div>

</div>

<div class="card mt-4 shadow">

    <div class="card-header bg-success text-white">

        Attendance History

        <!-- Export Button -->

        <div class="text-end attendances">

            <form asp-action="ExportAttendanceExcel"
                  asp-controller="HR"
                  method="post">

                <input type="hidden"
                       asp-for="EmployeeId" />

                <input type="hidden"
                       asp-for="FromDate" />

                <input type="hidden"
                       asp-for="ToDate" />

                <button type="submit"
                        class="btn btn-success">

                    Export Attendance to Excel

                </button>

            </form>

        </div>

    </div>

    <div class="card-body">

        <table class="table table-bordered table-hover">

            <thead>

                <tr>

                    <th>Date</th>

                    <th>Status</th>

                    <th>Remarks</th>

                </tr>

            </thead>

            <tbody>

                @if (Model.AttendanceList.Any())
                {
                    foreach (var item in Model.AttendanceList)
                    {
                        <tr>

                            <td>

                                @item.AttendanceDate

                            </td>

                            <td>

                                @if (item.Status == "Present")
                                {
                                    <span class="badge bg-success">

                                        Present

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Absent

                                    </span>
                                }

                            </td>

                            <td>

                                @item.Remarks

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="3"
                            class="text-center">

                            No Attendance Found

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>