@model CRMPortal.ViewModels.HRDashboardViewModel

@{
    ViewData["Title"] = "HR Dashboard";
}



@if (TempData["Success"] != null)
{
    <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">

        @TempData["Success"]

        <button class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div id="errorAlert" class="alert alert-danger alert-dismissible fade show" role="alert">

        @TempData["Error"]

        <button class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="container-fluid mt-3" style="margin-left: -110px;">

    <!-- Summary Card -->

    <div class="row mb-3" style="display: none;>
        <div class="col-md-8">

            <!-- Dashboard Cards -->

            <div class="row">

                <div class="col-md-4">

                    <div class="card shadow text-center">

                        <div class="card-body">

                            <h6>Total Employees</h6>

                            <h2 class="text-primary">

                                @ViewBag.TotalEmployees

                            </h2>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card shadow text-center">

                        <div class="card-body">

                            <h6>Active Employees</h6>

                            <h2 class="text-success">

                                @ViewBag.ActiveEmployees

                            </h2>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card shadow text-center">

                        <div class="card-body">

                            <h6>Inactive Employees</h6>

                            <h2 class="text-danger">

                                @ViewBag.InactiveEmployees

                            </h2>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <div class="row">

        <div class="col-lg-6">

            <!-- Employee Form -->
            <div class="card shadow mb-4">

                <div class="card-header bg-primary text-white">

                    <h5>Add Employee</h5>

                </div>

                <div class="card-body">
                    <form asp-action="@(Model.MasterEmployee.EmployeeId == 0 ? "AddEmployee" : "UpdateEmployee")"
                          method="post">

                            <input type="hidden" asp-for="MasterEmployee.EmployeeId" />

                            <div class="mb-3">

                                <label>Employee Code</label>
                            <input asp-for="MasterEmployee.EmployeeCode" placeholder="MTS00001" class="form-control" />

                            </div>

                           


                            <div class="mb-3">

                                <label>Full Name</label>

                                <input asp-for="MasterEmployee.FullName" placeholder="Full Name" class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label>Email</label>

                                <input asp-for="MasterEmployee.Email" placeholder="Email" class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label>Mobile Number</label>

                                <input asp-for="MasterEmployee.MobileNumber" class="form-control" maxlength="10" />

                            </div>

                            <div class="mb-3">

                                <label>Department</label>

                                <input asp-for="MasterEmployee.Department" class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label>Designation</label>

                                <input asp-for="MasterEmployee.Designation" class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label>Gender</label>

                                <select asp-for="MasterEmployee.Gender" class="form-control">

                                    <option>Male</option>

                                    <option>Female</option>

                                    <option>Other</option>

                                </select>

                            </div>

                            <div class="mb-3">

                                <label>Date Of Birth</label>

                                <input asp-for="MasterEmployee.DateOfBirth" type="date" class="form-control" />

                            </div>

                            <div class="mb-3">
                                <label>Joining Date</label>
                                <input asp-for="MasterEmployee.JoiningDate" type="date" class="form-control" />

                            </div>

                            <div class="mb-3">
                                <label>Salary</label>
                                <input asp-for="MasterEmployee.Salary" class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label>Status</label>

                                <select asp-for="MasterEmployee.EmployeeStatus" class="form-control">

                                    <option>Active</option>

                                    <option>Inactive</option>

                                </select>

                            </div>

                            <div class="mb-3">

                                <label>Blood Group</label>

                                <select asp-for="MasterEmployee.BloodGroup" class="form-control">

                                    <option value="">--Select Blood Group--</option>

                                    <option>A+</option>
                                    <option>A-</option>
                                    <option>B+</option>
                                    <option>B-</option>
                                    <option>AB+</option>
                                    <option>AB-</option>
                                    <option>O+</option>
                                    <option>O-</option>

                                </select>

                            </div>

                            <div class="mb-3">

                                <label>Marital Status</label>

                                <select asp-for="MasterEmployee.MaritalStatus" class="form-control">

                                    <option value="">--Select Marital Status--</option>

                                    <option>Single</option>
                                    <option>Married</option>
                                    <option>Divorced</option>
                                    <option>Widowed</option>

                                </select>

                            </div>

                            

                           

                          

                            <div class="mb-3">

                                <label>Address</label>

                                <textarea asp-for="MasterEmployee.AddressLine1"
                                          class="form-control"
                                          rows="3"></textarea>

                            </div>

                            

                            


                            <div class="mb-3">

                                <label>Pincode</label>

                                <input asp-for="MasterEmployee.Pincode"
                                       class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label>Employment Type</label>

                                <select asp-for="MasterEmployee.EmploymentType" class="form-select">
                                    <option value="">Select Employment Type</option>
                                    <option value="Permanent">Permanent</option>
                                    <option value="Contract">Contract</option>
                                    <option value="Intern">Intern</option>
                                    <option value="Part Time">Part Time</option>
                                </select>

                            </div>

                            <div class="mb-3">

                                <label>Reporting Manager</label>

                                <input asp-for="MasterEmployee.ReportingManager"
                                       class="form-control" />

                            </div>

                          

                            <div class="mb-3">

                                <label>Shift</label>

                                <select asp-for="MasterEmployee.Shift"
                                        class="form-control">

                                    <option value="">--Select Shift--</option>

                                    <option>Morning</option>
                                    <option>General</option>
                                    <option>Evening</option>
                                    <option>Night</option>

                                </select>

                            </div>

                            <div class="mb-3">

                                <label>Aadhaar Number</label>

                                <input asp-for="MasterEmployee.AadhaarNumber"
                                       class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label>PAN Number</label>

                                <input asp-for="MasterEmployee.PANNumber"
                                       class="form-control" />

                            </div>

                           

                            <div class="mb-3">

                                <label>Bank Name</label>

                                <input asp-for="MasterEmployee.BankName"
                                       class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label>Account Number</label>

                                <input asp-for="MasterEmployee.AccountNumber"
                                       class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label>IFSC Code</label>

                                <input asp-for="MasterEmployee.IFSCCode"
                                       class="form-control" />

                            </div>

                            @if (Model.MasterEmployee.EmployeeId == 0)
                            {
                                <button class="btn btn-success w-100">
                                    Save Employee
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-warning w-100">
                                    Update Employee
                                </button>
                            }

                        </form>

                </div>

            </div>
            

        </div>
    <div class="col-lg-6">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">

                <h4>
                    @if (Model.IsAttendanceEdit)
                    {
                        <i class="fa-solid fa-pen-to-square me-2"></i>
                        <span>Edit Employee Attendance</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-calendar-check me-2"></i>
                        <span>Employee Attendance</span>
                    }
                </h4>

            </div>

            <div class="card-body">

                <form asp-action="@(Model.IsAttendanceEdit ? "UpdateAttendance" : "SaveAttendance")"
                      method="post">

                    <!-- Attendance ID -->
                    <input type="hidden"
                           asp-for="EmployeeAttendance.AttendanceId" />


                    <!-- EMPLOYEE -->
                   <div class="mb-3 position-relative">

    <label>Employee</label>

    <!-- Search Box -->
    <input type="text"
           id="employeeName"
           class="form-control"
           placeholder="Search Employee Code or Name"
           autocomplete="off"
           value="@(Model.EmployeeAttendance?.EmployeeId > 0
                        ? Model.EmployeeList
                            .Where(x => x.EmployeeId ==
                                        Model.EmployeeAttendance.EmployeeId)
                            .Select(x => x.EmployeeCode + " - " + x.FullName)
                            .FirstOrDefault()
                        : "")"
           required />

    <!-- Employee ID -->
    <input type="hidden"
           asp-for="EmployeeAttendance.EmployeeId"
           id="EmployeeId" />


    <!-- Searchable Employee Dropdown -->
    <div id="employeeDropdown"
         class="list-group position-absolute w-100 shadow"
         style="display:none; z-index:1000; max-height:250px; overflow-y:auto;">

        @foreach (var emp in Model.EmployeeList)
        {
            <button type="button"
                    class="list-group-item list-group-item-action employee-option"
                    data-id="@emp.EmployeeId"
                    data-search="@($"{emp.EmployeeCode} {emp.FullName}")">

                <strong>@emp.EmployeeCode</strong>
                -
                @emp.FullName

            </button>
        }

    </div>

</div>


                    <!-- ATTENDANCE DATE -->
                    <div class="mb-3">

                        <label class="form-label">
                            Attendance Date
                        </label>

                        <input asp-for="EmployeeAttendance.AttendanceDate"
                               type="date"
                               class="form-control"
                               required />

                    </div>


                    <!-- STATUS -->
                    <div class="mb-3">

                        <label>Status</label>

                        <select asp-for="EmployeeAttendance.Status"
                                class="form-control"
                                required>

                            <option value="">Select Status</option>

                            <option value="Present">
                                Present
                            </option>

                            <option value="PL">
                                Paid Leave (PL)
                            </option>

                            <option value="HD">
                                Half Day (HD)
                            </option>

                            <option value="LWP">
                                Leave Without Pay (LWP)
                            </option>

                            <option value="ULWP">
                                Unplanned Leave Without Pay (ULWP)
                            </option>

                            <option value="Sandwich">
                                Sandwich Leave
                            </option>

                            <option value="Abscond">
                                Abscond
                            </option>

                            <option value="Terminated">
                                Terminated
                            </option>

                        </select>

                    </div>


                    <!-- REMARKS -->
                    <div class="mb-3">

                        <label>Remarks</label>

                        <textarea asp-for="EmployeeAttendance.Remarks"
                                  class="form-control"></textarea>

                    </div>


                    <!-- BUTTON -->
                    @if (Model.IsAttendanceEdit)
                    {
                        <button type="submit"
                                class="btn btn-warning">

                            <i class="fa-solid fa-pen-to-square me-1"></i>

                            Update Attendance

                        </button>

                        <a asp-action="ViewAttendance"
                           class="btn btn-secondary ms-2">

                            <i class="fa-solid fa-xmark me-1"></i>

                            Cancel

                        </a>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn btn-success">

                            <i class="fa-solid fa-floppy-disk me-1"></i>

                            Save Attendance

                        </button>
                    }

                </form>

            </div>

        </div>

    </div>

       

    </div>
</div>

<script>

    document.getElementById("employeeName").addEventListener("change", function () {

    var selectedEmployee = this.value;

    var options = document.querySelectorAll("#employeeList option");

    var employeeId = document.getElementById("EmployeeId");

    employeeId.value = "";

    options.forEach(function (option) {

        if (option.value === selectedEmployee) {

            employeeId.value =
                option.getAttribute("data-id");

        }

    });

});

</script>
