@model CRMPortal.ViewModels.HRDashboardViewModel

@{
    ViewData["Title"] = "HR Dashboard";
}

<style>

    /* =========================================================
           PAGE LAYOUT
           ========================================================= */

    .hr-dashboard-container {
        width: 100%;
        padding-left: 20px;
        padding-right: 20px;
        margin-top: 20px;
    }

    .dashboard-row {
        align-items: flex-start;
    }


    /* =========================================================
           CARDS
           ========================================================= */

    .dashboard-card {
        border: none;
        border-radius: 12px;
        overflow: visible;
    }

        .dashboard-card .card-header {
            background-color: #0d6efd !important;
            color: white;
            min-height: 56px;
            display: flex;
            align-items: center;
            padding: 14px 20px;
            border-radius: 12px 12px 0 0;
        }

            .dashboard-card .card-header h5,
            .dashboard-card .card-header h4 {
                margin: 0;
                font-size: 20px;
                font-weight: 600;
            }

        .dashboard-card .card-body {
            padding: 20px;
        }


    /* =========================================================
           FORM
           ========================================================= */

    .form-label {
        font-weight: 500;
        margin-bottom: 7px;
        color: #212529;
    }

    .form-control,
    .form-select {
        min-height: 42px;
        border: 1px solid #ced4da;
        border-radius: 10px;
        padding: 9px 13px;
        font-size: 14px;
    }

    textarea.form-control {
        min-height: auto;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.15);
    }

    .mb-3 {
        margin-bottom: 16px !important;
    }


    /* =========================================================
           EMPLOYEE SEARCH DROPDOWN
           ========================================================= */

    .employee-search-wrapper {
        position: relative;
    }

    #employeeDropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        z-index: 1050;
        max-height: 250px;
        overflow-y: auto;
        background: white;
        border: 1px solid #ced4da;
        border-radius: 0 0 10px 10px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.12);
    }

    .employee-option {
        display: block;
        width: 100%;
        text-align: left;
        padding: 10px 13px;
        border: 0;
        border-bottom: 1px solid #eeeeee;
        background: white;
        color: #212529;
        font-size: 14px;
        white-space: nowrap;
    }

        .employee-option:last-child {
            border-bottom: none;
        }

        .employee-option:hover {
            background-color: #f1f5f9;
            color: #0d6efd;
        }

    .employee-code {
        font-weight: 600;
        color: #0d6efd;
    }

    .employee-name {
        color: #212529;
    }

    .employee-separator {
        margin-left: 4px;
        margin-right: 4px;
        color: #6c757d;
    }


    /* =========================================================
           BUTTONS
           ========================================================= */

    .dashboard-card .btn {
        border-radius: 8px;
        min-height: 40px;
    }

    .save-employee-btn {
        width: 100%;
        margin-top: 5px;
    }


    /* =========================================================
           ALERT
           ========================================================= */

    #successAlert,
    #errorAlert {
        margin-left: 20px;
        margin-right: 20px;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    
        @@media (max-width: 991px) {

            .hr-dashboard-container {
                padding-left: 15px;
                padding-right: 15px;
            }

            .dashboard-card {
                margin-bottom: 20px;
            }
        }
</style>




<!-- ========================================================= -->
<!-- SUCCESS MESSAGE -->
<!-- ========================================================= -->
@if (TempData["Success"] != null)
{
    <div id="successAlert"
         class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="fa-solid fa-circle-check me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ========================================================= -->
<!-- ERROR MESSAGE -->
<!-- ========================================================= -->
@if (TempData["Error"] != null)
{
    <div id="errorAlert"
         class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="fa-solid fa-circle-exclamation me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ========================================================= -->
<!-- MAIN CONTAINER -->
<!-- ========================================================= -->

<div class="container-fluid hr-dashboard-container">

    <!-- ===================================================== -->
    <!-- SUMMARY CARD -->
    <!-- ===================================================== -->

    <div class="row mb-3"
         style="display:none;">

        <div class="col-md-3">

            <div class="card shadow">

                <div class="card-body">

                    <h6>Total Employees</h6>

                    <h3>
                        @Model.EmployeeList.Count
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- MAIN ROW -->
    <!-- ===================================================== -->

    <div class="row g-4 dashboard-row">


        <!-- ===================================================== -->
        <!-- LEFT SIDE - EMPLOYEE FORM -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card shadow dashboard-card">


                <!-- ================================================= -->
                <!-- CARD HEADER -->
                <!-- ================================================= -->

                <div class="card-header">

                    <h5>

                        @if (Model.MasterEmployee.EmployeeId == 0)
                        {
                            <i class="fa-solid fa-user-plus me-2"></i>
                            <span>Add Employee</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-user-pen me-2"></i>
                            <span>Update Employee</span>
                        }

                    </h5>

                </div>


                <!-- ================================================= -->
                <!-- CARD BODY -->
                <!-- ================================================= -->

                <div class="card-body">

                    <!-- ============================================= -->
                    <!-- EMPLOYEE FORM -->
                    <!-- ============================================= -->

                    <form asp-action="@(Model.MasterEmployee.EmployeeId == 0 ? "AddEmployee" : "UpdateEmployee")"
                          method="post">


                        <!-- Employee ID -->

                        <input type="hidden"
                               asp-for="MasterEmployee.EmployeeId" />


                        <!-- ========================================= -->
                        <!-- EMPLOYEE CODE -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Employee Code
                            </label>

                            <input asp-for="MasterEmployee.EmployeeCode"
                                   placeholder="MTS00001"
                                   class="form-control" />

                            <span asp-validation-for="MasterEmployee.EmployeeCode"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- FULL NAME -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Full Name
                            </label>

                            <input asp-for="MasterEmployee.FullName"
                                   placeholder="Full Name"
                                   class="form-control" />

                            <span asp-validation-for="MasterEmployee.FullName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- EMAIL -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input asp-for="MasterEmployee.Email"
                                   type="email"
                                   placeholder="Email"
                                   class="form-control" />

                            <span asp-validation-for="MasterEmployee.Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- MOBILE NUMBER -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Mobile Number
                            </label>

                            <input asp-for="MasterEmployee.MobileNumber"
                                   class="form-control"
                                   maxlength="10"
                                   inputmode="numeric"
                                   placeholder="10 digit mobile number" />

                            <span asp-validation-for="MasterEmployee.MobileNumber"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- EMERGENCY CONTACT NAME -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Emergency Contact Name
                            </label>

                            <input asp-for="MasterEmployee.EmergencyContactName"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="Emergency contact name" />

                            <span asp-validation-for="MasterEmployee.EmergencyContactName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- EMERGENCY CONTACT -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Emergency Contact
                            </label>

                            <input asp-for="MasterEmployee.EmergencyContact"
                                   class="form-control"
                                   maxlength="10"
                                   inputmode="numeric"
                                   placeholder="10 digit emergency contact number" />

                            <span asp-validation-for="MasterEmployee.EmergencyContact"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- DEPARTMENT -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Department
                            </label>

                            <input asp-for="MasterEmployee.Department"
                                   class="form-control"
                                   placeholder="Department" />

                            <span asp-validation-for="MasterEmployee.Department"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- DESIGNATION -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Designation
                            </label>

                            <input asp-for="MasterEmployee.Designation"
                                   class="form-control"
                                   placeholder="Designation" />

                            <span asp-validation-for="MasterEmployee.Designation"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- GENDER -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Gender
                            </label>

                            <select asp-for="MasterEmployee.Gender"
                                    class="form-select">

                                <option value="">
                                    -- Select Gender --
                                </option>

                                <option value="Male">
                                    Male
                                </option>

                                <option value="Female">
                                    Female
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                            <span asp-validation-for="MasterEmployee.Gender"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- DATE OF BIRTH -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Date Of Birth
                            </label>

                            <input asp-for="MasterEmployee.DateOfBirth"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="MasterEmployee.DateOfBirth"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- JOINING DATE -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Joining Date
                            </label>

                            <input asp-for="MasterEmployee.JoiningDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="MasterEmployee.JoiningDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- SALARY -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Salary
                            </label>

                            <input asp-for="MasterEmployee.Salary"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   placeholder="Salary" />

                            <span asp-validation-for="MasterEmployee.Salary"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- STATUS -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label asp-for="MasterEmployee.EmployeeStatus"
                                   class="form-label">
                                Status
                            </label>

                            <select asp-for="MasterEmployee.EmployeeStatus"
                                    class="form-select">

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                            <span asp-validation-for="MasterEmployee.EmployeeStatus"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- BLOOD GROUP -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Blood Group
                            </label>

                            <select asp-for="MasterEmployee.BloodGroup"
                                    class="form-select">

                                <option value="">
                                    -- Select Blood Group --
                                </option>

                                <option value="A+">A+</option>
                                <option value="A-">A-</option>

                                <option value="B+">B+</option>
                                <option value="B-">B-</option>

                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>

                                <option value="O+">O+</option>
                                <option value="O-">O-</option>

                            </select>

                            <span asp-validation-for="MasterEmployee.BloodGroup"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- MARITAL STATUS -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Marital Status
                            </label>

                            <select asp-for="MasterEmployee.MaritalStatus"
                                    class="form-select">

                                <option value="">
                                    -- Select Marital Status --
                                </option>

                                <option value="Single">
                                    Single
                                </option>

                                <option value="Married">
                                    Married
                                </option>

                                <option value="Divorced">
                                    Divorced
                                </option>

                                <option value="Widowed">
                                    Widowed
                                </option>

                            </select>

                            <span asp-validation-for="MasterEmployee.MaritalStatus"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- ADDRESS -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Address
                            </label>

                            <textarea asp-for="MasterEmployee.AddressLine1"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Address"></textarea>

                            <span asp-validation-for="MasterEmployee.AddressLine1"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- PINCODE -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Pincode
                            </label>

                            <input asp-for="MasterEmployee.Pincode"
                                   class="form-control"
                                   maxlength="6"
                                   inputmode="numeric"
                                   placeholder="Pincode" />

                            <span asp-validation-for="MasterEmployee.Pincode"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- EMPLOYMENT TYPE -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Employment Type
                            </label>

                            <select asp-for="MasterEmployee.EmploymentType"
                                    class="form-select">

                                <option value="">
                                    Select Employment Type
                                </option>

                                <option value="Permanent">
                                    Permanent
                                </option>

                                <option value="Contract">
                                    Contract
                                </option>

                                <option value="Intern">
                                    Intern
                                </option>

                                <option value="Part Time">
                                    Part Time
                                </option>

                            </select>

                            <span asp-validation-for="MasterEmployee.EmploymentType"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- REPORTING MANAGER -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Reporting Manager
                            </label>

                            <input asp-for="MasterEmployee.ReportingManager"
                                   class="form-control"
                                   placeholder="Reporting Manager" />

                            <span asp-validation-for="MasterEmployee.ReportingManager"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- SHIFT -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Shift
                            </label>

                            <select asp-for="MasterEmployee.Shift"
                                    class="form-select">

                                <option value="">
                                    -- Select Shift --
                                </option>

                                <option value="Morning">
                                    Morning
                                </option>

                                <option value="Afternoon">
                                    Afternoon
                                </option>

                                <option value="Night">
                                    Night
                                </option>

                            </select>

                            <span asp-validation-for="MasterEmployee.Shift"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- AADHAAR -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Aadhaar Number
                            </label>

                            <input asp-for="MasterEmployee.AadhaarNumber"
                                   class="form-control"
                                   maxlength="12"
                                   inputmode="numeric"
                                   placeholder="12 digit Aadhaar number" />

                            <span asp-validation-for="MasterEmployee.AadhaarNumber"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- PAN -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                PAN Number
                            </label>

                            <input asp-for="MasterEmployee.PANNumber"
                                   class="form-control"
                                   maxlength="10"
                                   placeholder="PAN Number" />

                            <span asp-validation-for="MasterEmployee.PANNumber"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- BANK NAME -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Bank Name
                            </label>

                            <input asp-for="MasterEmployee.BankName"
                                   class="form-control"
                                   placeholder="Bank Name" />

                            <span asp-validation-for="MasterEmployee.BankName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- ACCOUNT NUMBER -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Account Number
                            </label>

                            <input asp-for="MasterEmployee.AccountNumber"
                                   class="form-control"
                                   inputmode="numeric"
                                   placeholder="Account Number" />

                            <span asp-validation-for="MasterEmployee.AccountNumber"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- IFSC -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                IFSC Code
                            </label>

                            <input asp-for="MasterEmployee.IFSCCode"
                                   class="form-control"
                                   maxlength="11"
                                   placeholder="IFSC Code" />

                            <span asp-validation-for="MasterEmployee.IFSCCode"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- SAVE / UPDATE -->
                        <!-- ========================================= -->
                        @if (Model.MasterEmployee.EmployeeId == 0)
                        {
                            <button type="submit"
                                    class="btn btn-success save-employee-btn">

                                <i class="fa-solid fa-user-plus me-1"></i>

                                Save Employee

                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn btn-warning save-employee-btn">

                                <i class="fa-solid fa-user-pen me-1"></i>

                                Update Employee

                            </button>
                        }

                    </form>

                </div>

            </div>

        </div>



        <!-- ===================================================== -->
        <!-- RIGHT SIDE - ATTENDANCE -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card shadow dashboard-card">


                <!-- ================================================= -->
                <!-- ATTENDANCE HEADER -->
                <!-- ================================================= -->

                <div class="card-header">

                    <h5>

                        @if (Model.IsAttendanceEdit)
                        {
                            <i class="fa-solid fa-pen-to-square me-2"></i>

                            <span>
                                Edit Employee Attendance
                            </span>
                        }
                        else
                        {
                            <i class="fa-solid fa-calendar-check me-2"></i>

                            <span>
                                Employee Attendance
                            </span>
                        }

                    </h5>

                </div>


                <!-- ================================================= -->
                <!-- ATTENDANCE BODY -->
                <!-- ================================================= -->

                <div class="card-body">


                    <!-- ============================================= -->
                    <!-- ATTENDANCE FORM -->
                    <!-- ============================================= -->

                    <form asp-action="@(Model.IsAttendanceEdit ? "UpdateAttendance" : "SaveAttendance")"
                          method="post">


                        <!-- Attendance ID -->

                        <input type="hidden"
                               asp-for="EmployeeAttendance.AttendanceId" />


                        <!-- ========================================= -->
                        <!-- EMPLOYEE SEARCH -->
                        <!-- ========================================= -->

                        <div class="mb-3 employee-search-wrapper">

                            <label class="form-label">
                                Employee
                            </label>


                            <input type="text"
                                   id="employeeName"
                                   class="form-control"
                                   placeholder="Search Employee Code or Name"
                                   autocomplete="off"
                                   value="@(Model.EmployeeAttendance?.EmployeeId > 0
                                                                        ? Model.EmployeeList
                                                                            .Where(x => x.EmployeeId == Model.EmployeeAttendance.EmployeeId)
                                                                            .Select(x => x.EmployeeCode + " - " + x.FullName)
                                                                            .FirstOrDefault()
                                                                        : "")"
                                   required />


                            <!-- Hidden Employee ID -->

                            <input type="hidden"
                                   asp-for="EmployeeAttendance.EmployeeId"
                                   id="EmployeeId" />


                            <!-- ========================================= -->
                            <!-- EMPLOYEE DROPDOWN -->
                            <!-- ========================================= -->

                            <div id="employeeDropdown">

                                @foreach (var emp in Model.EmployeeList)
                                {
                                    <button type="button"
                                            class="employee-option"
                                            data-id="@emp.EmployeeId"
                                            data-code="@emp.EmployeeCode"
                                            data-name="@emp.FullName"
                                            data-search="@($"{emp.EmployeeCode} {emp.FullName}")">

                                        <span class="employee-code">
                                            @emp.EmployeeCode
                                        </span>

                                        <span class="employee-separator">
                                            -
                                        </span>

                                        <span class="employee-name">
                                            @emp.FullName
                                        </span>

                                    </button>
                                }

                            </div>

                        </div>


                        <!-- ========================================= -->
                        <!-- ATTENDANCE DATE -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Attendance Date
                            </label>

                            <input asp-for="EmployeeAttendance.AttendanceDate"
                                   type="date"
                                   class="form-control"
                                   required />

                            <span asp-validation-for="EmployeeAttendance.AttendanceDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- ATTENDANCE STATUS -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Status
                            </label>

                            <select asp-for="EmployeeAttendance.Status"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Status
                                </option>

                                <option value="Present">
                                    Present
                                </option>

                                <option value="PL">
                                    Paid Leave (PL)
                                </option>

                                <option value="HD">
                                    Half Day (HD)
                                </option>

                                <option value="H">
                                    Holiday (H)
                                </option>

                                <option value="NCNS">
                                    No Call No Show (NCNS)
                                </option>

                                <option value="LWP">
                                    Leave Without Pay (LWP)
                                </option>

                                <option value="ULWP">
                                    Unplanned Leave Without Pay (ULWP)
                                </option>

                                <option value="SL">
                                    Sandwich Leave
                                </option>

                                <option value="Abscond">
                                    Abscond
                                </option>

                                <option value="Terminated">
                                    Terminated
                                </option>

                            </select>

                            <span asp-validation-for="EmployeeAttendance.Status"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- REMARKS -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Remarks
                            </label>

                            <textarea asp-for="EmployeeAttendance.Remarks"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Attendance remarks"></textarea>

                            <span asp-validation-for="EmployeeAttendance.Remarks"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- BUTTONS -->
                        <!-- ========================================= -->
                        @if (Model.IsAttendanceEdit)
                        {
                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="fa-solid fa-pen-to-square me-1"></i>

                                Update Attendance

                            </button>

                            <a asp-action="ViewAttendance"
                               class="btn btn-secondary ms-2">

                                <i class="fa-solid fa-xmark me-1"></i>

                                Cancel

                            </a>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn btn-success">

                                <i class="fa-solid fa-floppy-disk me-1"></i>

                                Save Attendance

                            </button>
                        }

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- ========================================================= -->
<!-- EMPLOYEE SEARCH DROPDOWN SCRIPT -->
<!-- ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function() {

        const employeeInput =
            document.getElementById("employeeName");

        const employeeId =
            document.getElementById("EmployeeId");

        const employeeDropdown =
            document.getElementById("employeeDropdown");

        const employeeOptions =
            document.querySelectorAll(".employee-option");


        if (!employeeInput ||
            !employeeId ||
            !employeeDropdown) {

            return;

        }


        // =====================================================
        // FILTER EMPLOYEES
        // =====================================================

        function filterEmployees() {

            const searchText =
                employeeInput.value
                    .toLowerCase()
                    .trim();


            let visibleCount = 0;


            employeeOptions.forEach(function(option) {

                const searchValue =
                    option
                        .getAttribute("data-search")
                        .toLowerCase();


                if (searchText === "" ||
                    searchValue.includes(searchText)) {

                    option.style.display = "block";

                    visibleCount++;

                }
                else {

                    option.style.display = "none";

                }

            });


            if (visibleCount > 0) {

                employeeDropdown.style.display = "block";

            }
            else {

                employeeDropdown.style.display = "none";

            }

        }


        // =====================================================
        // INPUT FOCUS
        // =====================================================

        employeeInput.addEventListener("focus", function() {

            filterEmployees();

        });


        // =====================================================
        // INPUT SEARCH
        // =====================================================

        employeeInput.addEventListener("input", function() {

            // Clear selected employee
            employeeId.value = "";

            filterEmployees();

        });


        // =====================================================
        // SELECT EMPLOYEE
        // =====================================================

        employeeOptions.forEach(function(option) {

            option.addEventListener("click", function() {

                const selectedId =
                    this.getAttribute("data-id");

                const selectedCode =
                    this.getAttribute("data-code");

                const selectedName =
                    this.getAttribute("data-name");


                // IMPORTANT:
                // Build the value ourselves.
                // This prevents spaces/newlines from
                // the HTML formatting.

                employeeInput.value =
                    selectedCode + " - " + selectedName;


                employeeId.value =
                    selectedId;


                employeeDropdown.style.display =
                    "none";

            });

        });


        // =====================================================
        // CLICK OUTSIDE
        // =====================================================

        document.addEventListener("click", function(event) {

            if (!employeeInput.contains(event.target) &&
                !employeeDropdown.contains(event.target)) {

                employeeDropdown.style.display =
                    "none";

            }

        });


        // =====================================================
        // ESCAPE KEY
        // =====================================================

        employeeInput.addEventListener("keydown", function(event) {

            if (event.key === "Escape") {

                employeeDropdown.style.display =
                    "none";

            }

        });

    });

</script>



<!-- ========================================================= -->
<!-- VALIDATION SCRIPTS -->
<!-- ========================================================= -->
@section Scripts {

    @{

        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );

    }

}